@model ReceptionSystem.Models.JobApplication

<h4 class="mt-3 mb-4">Job Application</h4>

<div class="list-group">

    <a asp-controller="JobApplications"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="list-group-item list-group-item-action">
        Personal Information
    </a>

    <a asp-controller="Qualifications"
       asp-action="Index"
       asp-route-jobApplicationId="@Model.Id"
       class="list-group-item list-group-item-action">
        Qualifications
    </a>

    <a asp-controller="Courses"
       asp-action="Index"
       asp-route-jobApplicationId="@Model.Id"
       class="list-group-item list-group-item-action">
        Courses & Training
    </a>

    <a asp-controller="Experiences"
       asp-action="Index"
       asp-route-jobApplicationId="@Model.Id"
       class="list-group-item list-group-item-action">
        Experiences
    </a>

    <a asp-controller="Languages"
       asp-action="Index"
       asp-route-jobApplicationId="@Model.Id"
       class="list-group-item list-group-item-action">
        Languages
    </a>

    <a asp-controller="ComputerSkills"
       asp-action="Index"
       asp-route-jobApplicationId="@Model.Id"
       class="list-group-item list-group-item-action">
        Computer Skills
    </a>

    <a asp-controller="JobApplications"
       asp-action="UploadCV"
       asp-route-id="@Model.Id"
       class="list-group-item list-group-item-action">
        CV Upload
    </a>

</div>
