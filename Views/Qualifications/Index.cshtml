@model IEnumerable<ReceptionSystem.Models.Qualification>

@{
    ViewData["Title"] = "المؤهلات العلمية";
}

<div class="container-fluid mt-4" dir="rtl" lang="ar">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>المؤهلات العلمية</h1>

        <a asp-action="Create" class="btn btn-primary">
            + إنشاء جديد
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive dama-table-scroll">

                <table class="table table-bordered table-striped table-hover align-middle text-nowrap">

                    <thead class="dama-thead-sticky">
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Degree)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.Specialization)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.University)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.GraduationYear)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.JobApplicationId)
                            </th>
                            <th>
                                @Html.DisplayNameFor(model => model.JobApplication)
                            </th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(model => item.Degree)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.Specialization)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.University)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.GraduationYear)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.JobApplicationId)
                                </td>
                                <td>
                                    @Html.DisplayFor(model => item.JobApplication)
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>