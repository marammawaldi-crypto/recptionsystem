            <!-- CV Section -->
            <div class="card mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">CV</h5>
                </div>

                <div class="card-body">

                    <form method="post"
                          asp-action="AddCV"
                          enctype="multipart/form-data"
                          class="mt-2">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row align-items-end">

                            <div class="col-md-10">
                                <label class="form-label">Upload CV</label>

                                <input type="file"
                                       name="cvFile"
                                       class="form-control"
                                       accept=".pdf,.doc,.docx" />

                                <small class="text-muted">
                                    Allowed files: PDF, DOC, DOCX
                                </small>
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-danger w-100">
                                    Add CV
                                </button>
                            </div>

                        </div>

                    </form>

                </div>
            </div>
