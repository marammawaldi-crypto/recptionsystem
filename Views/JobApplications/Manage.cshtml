
@model ReceptionSystem.Models.JobApplication

@{
    ViewData["Title"] = "Manage Job Application";
}

<div class="container-fluid">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-md-3 bg-light border-end" style="min-height:700px;">
            <partial name="_JobApplicationSidebar" model="Model" />
        </div>

        <!-- Content -->
        <div class="col-md-9 p-4">
            <div class="mb-4">
                <h2>Manage Job Application</h2>
                <p class="text-muted">
                    Application #: <strong>@Model.ApplicationNumber</strong> |
                    Applicant: <strong>@Model.FullName</strong>
                </p>
                <hr />
            </div>

            <!-- Success/Error Messages -->
            @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Error!</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close"
                            data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Languages Section -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Languages</h5>
                </div>

                <div class="card-body">
                    @if (Model.Languages != null && Model.Languages.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Language</th>
                                    <th>Speaking</th>
                                    <th>Writing</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var lang in Model.Languages)
                                {
                                    <tr>
                                        <td>@lang.LanguageName</td>
                                        <td>@lang.Speaking</td>
                                        <td>@lang.Writing</td>
                                        <td>
                                            <form method="post"
                                                  asp-action="DeleteLanguage"
                                                  style="display:inline;">
                                                <input type="hidden"
                                                       name="languageId"
                                                       value="@lang.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this language?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No languages added yet.</p>
                    }

                    <!-- Add Language Form -->
                    <form method="post"
                          asp-action="AddLanguage"
                          class="mt-3">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row">

                            <div class="col-md-4">
                                <input type="text"
                                       name="languageName"
                                       placeholder="Language"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-3">
                                <select name="speaking"
                                        class="form-control form-control-sm">

                                    <option value="">Speaking Level</option>
                                    <option>ممتاز</option>
                                    <option>جيد جداً</option>
                                    <option>جيد</option>
                                    <option>مقبول</option>

                                </select>
                            </div>

                            <div class="col-md-3">
                                <select name="writing"
                                        class="form-control form-control-sm">

                                    <option value="">Writing Level</option>
                                    <option>ممتاز</option>
                                    <option>جيد جداً</option>
                                    <option>جيد</option>
                                    <option>مقبول</option>

                                </select>
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>


            <!-- Computer Skills Section -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Computer Skills</h5>
                </div>

                <div class="card-body">
                    @if (Model.ComputerSkills != null && Model.ComputerSkills.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Skill</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var skill in Model.ComputerSkills)
                                {
                                    <tr>
                                        <td>@skill.SkillName</td>

                                        <td>
                                            <form method="post"
                                                  asp-action="DeleteComputerSkill"
                                                  style="display:inline;">

                                                <input type="hidden"
                                                       name="skillId"
                                                       value="@skill.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this skill?');">
                                                    Delete
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            No computer skills added yet.
                        </p>
                    }

                    <!-- Add Computer Skill Form -->
                    <form method="post"
                          asp-action="AddComputerSkill"
                          class="mt-3">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row">

                            <div class="col-md-10">
                                <input type="text"
                                       name="skillName"
                                       placeholder="Enter skill (e.g., Microsoft Word, Excel, Photoshop)"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>


            <!-- Qualifications Section -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Qualifications</h5>
                </div>

                <div class="card-body">
                    @if (Model.Qualifications != null && Model.Qualifications.Any())
                    {
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Degree</th>
                                    <th>Specialization</th>
                                    <th>University</th>
                                    <th>Graduation Year</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var qual in Model.Qualifications)
                                {
                                    <tr>
                                        <td>@qual.Degree</td>
                                        <td>@qual.Specialization</td>
                                        <td>@qual.University</td>
                                        <td>@qual.GraduationYear</td>

                                        <td>
                                            <form method="post"
                                                  asp-action="DeleteQualification"
                                                  style="display:inline;">

                                                <input type="hidden"
                                                       name="qualificationId"
                                                       value="@qual.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this qualification?');">
                                                    Delete
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            No qualifications added yet.
                        </p>
                    }

                    <!-- Add Qualification Form -->
                    <form method="post"
                          asp-action="AddQualification"
                          class="mt-3">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row">

                            <div class="col-md-2">
                                <input type="text"
                                       name="degree"
                                       placeholder="Degree"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-3">
                                <input type="text"
                                       name="specialization"
                                       placeholder="Specialization"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-3">
                                <input type="text"
                                       name="university"
                                       placeholder="University/Institute"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="number"
                                       name="graduationYear"
                                       placeholder="Year"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>


            <!-- Experiences Section -->
            <div class="card mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">Work Experience</h5>
                </div>

                <div class="card-body">
                    @if (Model.Experiences != null && Model.Experiences.Any())
                    {
                        <table class="table table-sm table-striped">

                            <thead>
                                <tr>
                                    <th>Company</th>
                                    <th>Job Title</th>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Last Salary</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var exp in Model.Experiences)
                                {
                                    <tr>
                                        <td>@exp.CompanyName</td>
                                        <td>@exp.JobTitle</td>
                                        @(exp.FromDate.HasValue ? exp.FromDate.Value.ToString("d") : "")
                                        @(exp.ToDate.HasValue ? exp.ToDate.Value.ToString("d") : "")
                                        <td>@exp.LastSalary</td>

                                        <td>
                                            <form method="post"
                                                  asp-action="DeleteExperience"
                                                  style="display:inline;">

                                                <input type="hidden"
                                                       name="experienceId"
                                                       value="@exp.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this experience?');">
                                                    Delete
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            No experiences added yet.
                        </p>
                    }

                    <!-- Add Experience Form -->
                    <form method="post"
                          asp-action="AddExperience"
                          class="mt-3">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row">

                            <div class="col-md-2">
                                <input type="text"
                                       name="companyName"
                                       placeholder="Company"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="text"
                                       name="jobTitle"
                                       placeholder="Job Title"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="date"
                                       name="fromDate"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="date"
                                       name="toDate"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="number"
                                       name="lastSalary"
                                       placeholder="Salary"
                                       step="0.01"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>


            <!-- Courses Section -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">Courses & Training</h5>
                </div>

                <div class="card-body">
                    @if (Model.Courses != null && Model.Courses.Any())
                    {
                        <table class="table table-sm table-striped">

                            <thead>
                                <tr>
                                    <th>Course Name</th>
                                    <th>Organization</th>
                                    <th>Duration</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var course in Model.Courses)
                                {
                                    <tr>
                                        <td>@course.CourseName</td>
                                        <td>@course.Organization</td>
                                        <td>@course.Duration</td>

                                        <td>
                                            <form method="post"
                                                  asp-action="DeleteCourse"
                                                  style="display:inline;">

                                                <input type="hidden"
                                                       name="courseId"
                                                       value="@course.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Delete this course?');">
                                                    Delete
                                                </button>

                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p class="text-muted">
                            No courses added yet.
                        </p>
                    }

                    <!-- Add Course Form -->
                    <form method="post"
                          asp-action="AddCourse"
                          class="mt-3">

                        <input type="hidden"
                               name="jobApplicationId"
                               value="@Model.Id" />

                        <div class="row">

                            <div class="col-md-4">
                                <input type="text"
                                       name="courseName"
                                       placeholder="Course Name"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-4">
                                <input type="text"
                                       name="organization"
                                       placeholder="Organization"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <input type="text"
                                       name="duration"
                                       placeholder="Duration"
                                       class="form-control form-control-sm" />
                            </div>

                            <div class="col-md-2">
                                <button type="submit"
                                        class="btn btn-sm btn-success w-100">
                                    Add
                                </button>
                            </div>

                        </div>
                    </form>
                </div>
            </div>

