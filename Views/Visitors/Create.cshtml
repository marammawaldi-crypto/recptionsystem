@model ReceptionSystem.Models.Visitor

@{
    ViewData["Title"] = "إضافة زائر";
}

<div class="visitors-page" dir="rtl">

    <h4>إضافة زائر</h4>

    <hr />

    <div class="row">

        <div class="col-md-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <!-- اسم الزائر -->
                <div class="form-group mb-3">

                    <label asp-for="VisitorName"
                           class="control-label">
                        اسم الزائر
                    </label>

                    <input asp-for="VisitorName"
                           class="form-control"
                           dir="rtl" />

                    <span asp-validation-for="VisitorName"
                          class="text-danger">
                    </span>

                </div>


                <!-- تاريخ الزيارة -->
                <div class="form-group mb-3">

                    <label asp-for="VisitDate"
                           class="control-label">
                        تاريخ الزيارة
                    </label>

                    <input asp-for="VisitDate"
                           type="date"
                           lang="en"
                           class="form-control" />

                    <span asp-validation-for="VisitDate"
                          class="text-danger">
                    </span>

                </div>


                <!-- وقت الدخول -->
                <div class="form-group mb-3">

                    <label asp-for="CheckIn"
                           class="control-label">
                        وقت الدخول
                    </label>

                    <input asp-for="CheckIn"
                           type="time"
                           lang="en"
                           class="form-control" />

                    <span asp-validation-for="CheckIn"
                          class="text-danger">
                    </span>

                </div>


                <!-- وقت الخروج -->
                <div class="form-group mb-3">

                    <label asp-for="CheckOut"
                           class="control-label">
                        وقت الخروج
                    </label>

                    <input asp-for="CheckOut"
                           type="time"
                           lang="en"
                           class="form-control" />

                    <span asp-validation-for="CheckOut"
                          class="text-danger">
                    </span>

                </div>


                <!-- الوجهة -->
                <div class="form-group mb-3">

                    <label asp-for="Destination"
                           class="control-label">
                        الوجهة
                    </label>

                    <select asp-for="Destination"
                            class="form-control"
                            dir="rtl">

                        <option value="">
                            -- اختر الوجهة --
                        </option>

                        <option value="Finance / Cash">
                            المالية / الصندوق
                        </option>

                        <option value="الإدارة">
                            الإدارة
                        </option>

                        <option value=" الموارد البشرية">
                            الموارد البشرية
                        </option>

                        <option value="الإدارة المالية">
                            الإدارة المالية
                        </option>

                        <option value="المشتريات">
                            المشتريات
                        </option>

                        <option value="قسم تكنولوجيا المعلومات">
                            قسم تكنولوجيا المعلومات
                        </option>

                        <option value=" القسم القانوني">
                            القسم القانوني
                        </option>

                        <option value=" المبيعات">
                            المبيعات
                        </option>

                        <option value="العمليات">
                            العمليات
                        </option>

                        <option value="المستودع">
                            المستودع
                        </option>

                        <option value="أخرى">
                            أخرى
                        </option>

                    </select>

                    <span asp-validation-for="Destination"
                          class="text-danger">
                    </span>

                </div>


                <!-- رقم الهاتف -->
                <div class="form-group mb-3">

                    <label asp-for="Phone"
                           class="control-label">
                        رقم الهاتف
                    </label>

                    <input asp-for="Phone"
                           class="form-control"
                           dir="rtl" />

                    <span asp-validation-for="Phone"
                          class="text-danger">
                    </span>

                </div>


                <!-- الغرض -->
                <div class="form-group mb-3">

                    <label asp-for="Purpose"
                           class="control-label">
                        الغرض
                    </label>

                    <input asp-for="Purpose"
                           class="form-control"
                           dir="rtl" />

                    <span asp-validation-for="Purpose"
                          class="text-danger">
                    </span>

                </div>


                <!-- ملاحظات -->
                <div class="form-group mb-3">

                    <label asp-for="Notes"
                           class="control-label">
                        ملاحظات
                    </label>

                    <input asp-for="Notes"
                           class="form-control"
                           dir="rtl" />

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>

                </div>


                <!-- زر الإضافة -->
                <div class="form-group mb-3">

                    <input type="submit"
                           value="إضافة زائر"
                           class="btn btn-primary" />

                </div>

            </form>

        </div>

    </div>


    <div>

        <a asp-action="Index">
            العودة إلى قائمة الزوار
        </a>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}